# ==========================================
# WarehouseVision AI - Backend Environment Config
# ==========================================

# Application
APP_NAME=WarehouseVision AI
ENVIRONMENT=development
DEBUG=true

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=warehousevision

# Security & JWT Authentication
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL (CORS allowed origins)
FRONTEND_URL=http://localhost:5173

# Storage Configuration (Relative to backend directory or absolute path)
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
SNAPSHOT_DIR=storage/snapshots

# Computer Vision & File Limits
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.40
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=cpu
YOLO_IMAGE_SIZE=640
YOLO_MAX_DETECTIONS=100
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=200
VIDEO_FRAME_INTERVAL=1

# Object Tracking
# Supported: bytetrack, botsort
TRACKER_TYPE=bytetrack
TRACKER_CONFIDENCE_THRESHOLD=0.25
TRACKER_IOU_THRESHOLD=0.5
# Max frames a track can be missing before removal (informational; ByteTrack
# uses its bundled YAML config for this value internally).
TRACKER_MAX_AGE=30

# Safety Monitoring (Rule-Based Heuristic Layer)
SAFETY_ENABLED=true
PERSON_CLASSES=person
FORKLIFT_CLASSES=forklift
PROXIMITY_WARNING_DISTANCE=100
COLLISION_WARNING_DISTANCE=50
RESTRICTED_ZONE_ENABLED=true
EVENT_COOLDOWN_SECONDS=5
VELOCITY_WINDOW_FRAMES=5

# PPE Compliance Monitoring
# Requires a YOLO model trained on PPE classes (helmet, vest, etc.).
# A generic pretrained YOLO model may NOT support these classes.
PPE_ENABLED=true
# Leave empty to use the main model if it contains PPE classes;
# set to a path for a dedicated PPE model (e.g. ppe_yolo.pt).
PPE_MODEL_PATH=
PPE_HELMET_CLASSES=helmet,safety helmet
PPE_VEST_CLASSES=vest,safety vest
PPE_GLOVE_CLASSES=gloves,glove
PPE_SHOE_CLASSES=boots,safety shoes
REQUIRED_PPE=helmet,vest
PPE_ASSOCIATION_IOU_THRESHOLD=0.10
PPE_MISSING_CONFIRMATION_FRAMES=5
PPE_EVENT_COOLDOWN_SECONDS=10

# Inventory Monitoring
# Configurable classes tracked and monitored for inventory counts and stock levels
INVENTORY_ENABLED=true
INVENTORY_CLASSES=box,pallet,crate
INVENTORY_CONFIDENCE_THRESHOLD=0.40
INVENTORY_COUNT_MODE=visible
INVENTORY_SNAPSHOT_INTERVAL_SECONDS=10
INVENTORY_CHANGE_THRESHOLD=1
INVENTORY_LOW_STOCK_ENABLED=true
INVENTORY_EVENT_COOLDOWN_SECONDS=10
INVENTORY_THRESHOLDS_JSON={"box":5,"pallet":2,"crate":3}
